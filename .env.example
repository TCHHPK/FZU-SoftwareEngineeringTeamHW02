# 复制为 .env 后填写。.env 不要提交到仓库。

# ---------- 大模型（OpenAI 兼容协议，以下任选其一） ----------
# DeepSeek:  https://api.deepseek.com/v1        model=deepseek-chat
# 通义千问:  https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# Kimi:      https://api.moonshot.cn/v1         model=moonshot-v1-32k
# 校内 vLLM: http://127.0.0.1:8000/v1           model=<部署名>
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 密钥管理约定（重要，按此执行可避免额度纠纷与泄露）：
#   1. 主 key 只放进「服务器」的 .env，不要放到任何成员的本机；
#   2. 需要在本地调试的同学（Agent 管线开发），请在同一账号下另建一个 key，
#      私聊获取并写进本机 .env —— 独立 key 便于分别统计消耗、泄露后单独吊销；
#   3. 同一账号的多个 key 可以都写在这一行，用英文逗号分隔，客户端会自动轮换，
#      用于规避单 key 限流（答辩现场用得上）；
#   4. 跨厂商备份只需改上面两行：LLM_BASE_URL 与 LLM_MODEL，代码无需改动；
#   5. 「裸调用模型 vs 本系统管线」的对比实验必须用同一个 key、同一模型跑完，
#      不要多人分工各跑一半。
LLM_API_KEYS=sk-主key,sk-备用key
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ---------- 应用 ----------
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-string
SESSION_MAX_AGE=604800

# ---------- 存储 ----------
STORAGE_DIR=storage
MAX_UPLOAD_MB=50
# 支持的学习资料格式。
#   已实现（不需要外部服务）：pdf pptx docx txt md markdown text html htm csv epub
#   需要 OCR 才能读：png jpg jpeg webp bmp；扫描版 PDF 同样需要 OCR
ALLOWED_EXTENSIONS=.pdf,.pptx,.docx,.txt,.md,.markdown,.html,.htm,.csv,.epub,.png,.jpg,.jpeg

# ---------- OCR（识别图片与扫描件里的文字） ----------
# 使用阿里云「文字识别 OCR」，开通后有每月免费额度，具体以官方页面为准：
# https://help.aliyun.com/zh/ocr/product-overview/free-quota.md
# 不填这两项时，图片与扫描版 PDF 会给出「需配置 OCR」的明确提示，而不是静默失败。
OCR_PROVIDER=aliyun
OCR_ACCESS_KEY_ID=
OCR_ACCESS_KEY_SECRET=
OCR_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
OCR_TIMEOUT=30

# ---------- 功能开关（未实现的功能一律置 0，不要留半成品入口） ----------
ENABLE_VECTOR=0            # 向量检索：默认关闭，FTS5 为主
ENABLE_EXAMPLE=1           # OP-01 例题整理
ENABLE_NOTE_MERGE=1        # OP-04 增量合并与版本
ENABLE_EXAM_SCOPE=1        # OP-05 考试范围复习
ENABLE_QUALITY_EVAL=1      # OP-06 固定权重质量自评
ENABLE_FORMULA_OCR=0       # OP-02 手写公式转 LaTeX（本期不实施）
